<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.windtunnel.history-bot</string>
  <key>WorkingDirectory</key><string>__DEST__</string>
  <key>ProgramArguments</key>
  <array><string>__NODE__</string><string>--env-file=.env</string><string>bot.mjs</string></array>
  <key>EnvironmentVariables</key><dict><key>BOT_DATA_DIR</key><string>__DEST__/data</string></dict>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__DEST__/data/bot.log</string>
  <key>StandardErrorPath</key><string>__DEST__/data/bot.log</string>
</dict>
</plist>
